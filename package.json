{
    "name": "call-charts",
    "displayName": "Call Charts",
    "description": "Hover any function to see its call flow chart. Expand into an interactive, animated call graph with path tracing and per-function details.",
    "version": "0.6.0",
    "publisher": "waleed",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/wahmd/call-charts.git"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Visualization",
        "Other"
    ],
    "keywords": [
        "call graph",
        "call hierarchy",
        "flow chart",
        "visualize",
        "hover",
        "code navigation"
    ],
    "activationEvents": [
        "onLanguage:typescript",
        "onLanguage:typescriptreact",
        "onLanguage:javascript",
        "onLanguage:javascriptreact"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "configuration": {
            "title": "Call Charts",
            "properties": {
                "callCharts.maxWidth": {
                    "type": "number",
                    "default": 820,
                    "description": "Maximum rendered chart width in px; larger charts are scaled down to fit."
                },
                "callCharts.maxHeight": {
                    "type": "number",
                    "default": 380,
                    "description": "Maximum rendered chart height in px; larger charts are scaled down to fit."
                },
                "callCharts.minScale": {
                    "type": "number",
                    "default": 0.5,
                    "description": "Lower bound on downscaling (0-1). Charts that would need to shrink further scroll instead."
                },
                "callCharts.animation": {
                    "type": "boolean",
                    "default": true,
                    "description": "Animate the charts: staggered reveal and flow packets along call edges."
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -w -p ./",
        "lint": "eslint src media test --ext .ts,.js",
        "test": "npm run compile && node --test \"test/unit/*.test.js\"",
        "test:e2e": "npm run compile && node --test \"test/e2e/*.test.js\"",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "package": "vsce package",
        "install:local": "code --install-extension call-charts-$npm_package_version.vsix",
        "vscode:prepublish": "npm run compile"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/vscode": "^1.85.0",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "@vscode/vsce": "^2.29.0",
        "eslint": "^8.57.0",
        "playwright": "^1.45.0",
        "prettier": "^3.3.0",
        "typescript": "^5.4.0"
    }
}
